SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6Ik9...

# ─── AI Worker (Cloudflare) ────────────────────────
# URL del Worker que corre el modelo de diagnóstico
AI_WORKER_URL=https://tu-worker.tu-nombre.workers.dev
# API key secreta para autenticar la llamada desde Next.js al Worker
AI_WORKER_SECRET=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── OAuth ─────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Rate Limiting (Upstash Redis opcional) ────────
# Si no configuras Upstash, se usará rate limiter en memoria
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
